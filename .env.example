# Copie este arquivo com o nome ".env" e preencha a chave.
# O arquivo .env fica só no seu computador e não vai para o Git.

# Chave da API da Anthropic (crie em https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo do Claude usado pelo chat
CLAUDE_MODEL=claude-haiku-5-5

# Tamanho máximo de cada resposta, em tokens
MAX_TOKENS=8000

# Limites de uso (controle de custo e de abuso)
MAX_CARACTERES_MENSAGEM=2000
MAX_MENSAGENS_HISTORICO=20
LIMITE_REQUISICOES_POR_MINUTO=10

# Busca na web do módulo geral (1 = ligada, 0 = desligada).
# Cada busca é cobrada à parte pela Anthropic.
BUSCA_WEB=1
BUSCA_WEB_MAX_USOS=3
# Domínios em que a busca pode procurar, separados por vírgula.
# Deixe vazio para liberar qualquer site.
BUSCA_WEB_DOMINIOS=gov.br,jus.br,leg.br,mp.br,def.br
